services:
	- App\Core\RouterFactory::createRouter
	- App\Model\Settings\AppSettings(%info%, %seo%, %system%)
	- create: App\Core\Authentication\FrontAuthenticator
		autowired: self
	- create: App\Core\Authentication\AdminAuthenticator
		autowired: self

search:
	-	in: %appDir%
		classes:
			- *Facade
			- *Factory
			- *Repository
			- *Service
			- *DbMapper
