# Docker and app environment (template: .env.example)
/.env

# Local DI configuration - holds database credentials, must never be committed
/config/local.dev.neon
/config/local.prod.neon

# Deployment settings with the FTP password (template: config/deployment.example.ini)
/config/deployment.ini

# Writable runtime directories (keep the dir, ignore the contents)
/temp/*
!/temp/.gitignore
!/temp/.htaccess
!/temp/web.config
/log/*
!/log/.gitignore
!/log/.htaccess
!/log/web.config

# PHPUnit test cache
/.phpunit.cache/

# Uploaded content (the .htaccess denies script execution there)
/www/resources/*
!/www/resources/.htaccess

# Editors / OS
.idea/
*.swp
.DS_Store
Thumbs.db

/vendor/
/db/dumps/*
!/db/dumps/.gitkeep
