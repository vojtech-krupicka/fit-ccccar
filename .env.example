# Copy to .env (`cp .env.example .env`). Every variable here is passed into both
# containers (docker-compose.yml `env_file`) and also used for ${...} substitution.
# The db container's root password is set in docker-compose.yml, not here, so
# it isn't exposed to PHP.

# Database (MySQL creates this database and user on first start of the volume).
# The test database is called <MYSQL_DATABASE>_test and is created for the same user.
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app

# Where the app finds MySQL (service name + port inside the compose network)
DB_HOST=db
DB_PORT=3306

# Port on your machine for http://localhost:<WEB_PORT>
WEB_PORT=8080

# Container user IDs; run `id -u` / `id -g` on the host if yours aren't 1000
USER_UID=1000
USER_GID=1000
