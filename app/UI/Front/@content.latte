<h1 n:ifset="$pageHeading">{$pageHeading}</h1>
{*
<?php if (count($CC_TEMPLATE->breadcrumb) > 0): ?>
    <ul class="breadcrumb">
        <li class="home"><a href="<?php echo CC_Utils::link(':Homepage:default'); ?>" title="Domů"><span class="icon-home"></span></a></li>
        <?php foreach ($CC_TEMPLATE->breadcrumb as $item): ?>
            <li<?php echo ($item === end($CC_TEMPLATE->breadcrumb)) ? ' class="active"' : ''; ?>><span class="icon-arrow-right"></span><a href="<?php echo CC_Utils::link($item->href, $item->params); ?>" title="<?php echo $item->title; ?>"><?php echo $item->title; ?></a></li>
        <?php endforeach; ?>
    </ul>
<?php endif; ?> *}

{* {control breadcrumb items: $breadcrumbItems} *}

{snippet flashes}
<div n:foreach="$flashes as $flash" class="alert alert-dismissable alert-{$flash->type}">
    <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
    <p>{$flash->message}</p>
</div>
{/snippet}

<article class="page">
    {include content}
</article>
