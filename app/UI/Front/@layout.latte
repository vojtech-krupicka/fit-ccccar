<!doctype html>
<html lang="cs">

<head>
    <meta charset="utf-8">
    <meta name="author" content="{$args->system->author}" />
    <meta name="keywords" content="{$args->seo->keywords|striptags}" />
    <meta name="description" content="{$args->seo->description|striptags}" />
    <meta name="robots" content="index, follow" />
    {block meta}{/block}

    <title>.: {$args->info->company}{if $pageHeading} | {$pageHeading|striptags}{/if} :.</title>

    {asset 'css/bootstrap.css'}
    {asset 'css/bootstrap-theme.css'}
    {asset 'css/font-awesome.css'}
    {asset 'css/style.css'}
    {block css}{/block}

    <link rel="icon" type="image/x-icon" href="{asset? 'images/favicon.ico'}">
</head>

<body>
    <form method="post" id="postForm"></form>

    <div id="container">
        <header>
            {import '@header.latte'}
            {include header}
        </header>

        <main>
            {import '@main.latte'}
            {include main}
        </main>

        <footer>
            {import '@footer.latte'}
            {include footer}
        </footer>
    </div>


    <!-- jQuery (necessary for Bootstrap's JavaScript plugins) -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.0/jquery.min.js"></script>

    <!-- Include all compiled plugins (below), or include individual files as needed -->
    {asset "js/bootstrap.min.js"}
    {asset "js/netteForms.min.js"}

    <script src="https://unpkg.com/naja@3/dist/Naja.min.js"></script>
    {asset "js/app.js"}
</body>

</html>
