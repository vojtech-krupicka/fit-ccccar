{block content}

<div class="detail">
    <div class="row">
        <div class="col-md-6 image">
            <img class="thumbnail" src="{asset '/img/vehicles/default.jpg'}" />
        </div>
        <div class="col-md-6">
            <div class="info">
                <h2>{$vehicle->getFullName()}</h2>
                <dl class="dl-horizontal">
                    <dt>SPZ:</dt>
                    <dd>{$vehicle->plateNumber}</dd>
                    <dt>Výrobce:</dt>
                    <dd>{$vehicle->type->manufacturer}</dd>
                    <dt>Model:</dt>
                    <dd>{$vehicle->type->brand} {$vehicle->model}</dd>
                    <dt>Barva:</dt>
                    <dd>{$vehicle->color->name} (kód: <span class="color" style="background-color: #{$vehicle->color->hex}"></span>{$vehicle->color->hex})</dd>
                    <dt>Typ paliva:</dt>
                    <dd>{$vehicle->fuelType->name}</dd>
                    <dt>Rok výroby:</dt>
                    <dd>{$vehicle->year}</dd>
                    <dt>Najeto:</dt>
                    <dd>{$vehicle->mileage|number:2} km</dd>
                    <dt>Cena/den:</dt>
                    <dd>{if $vehicle->costPerDay < 0.01}<strong class="text-success">ZDARMA</strong>{else}{$vehicle->costPerDay|number}Kč{/if}</dd>
                    <dt>Cena/km:</dt>
                    <dd>{if $vehicle->costPerUnit < 0.01}<strong class="text-success">ZDARMA</strong>{else}{$vehicle->costPerUnit|number}Kč{/if}</dd>
                    <dt>Dostupnost:</dt>
                    <dd><strong class="text-success">dostupné</strong></dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="row" id="borrow">
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading"><h3 class="panel-title">Rezervace</h3></div>
                <div class="panel-body">
                    {if $user->isLoggedIn()}
                        {form reservationForm}
                            <div class="row">
                                <div class=" col-md-6">
                                    <div class="form-group">
                                        <div class="col-sm-3">{label reserveFrom/}</div>
                                        <div class="col-sm-9">{input reserveFrom}</div>
                                    </div>
                                </div>
                                <div class=" col-md-6">
                                    <div class="form-group">
                                        <div class="col-sm-3">{label reserveTo/}</div>
                                        <div class="col-sm-9">{input reserveTo}</div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class=" col-md-6">
                                    <div class="form-group">
                                        <div class="col-sm-3">{label rentalOffice/}</div>
                                        <div class="col-sm-9">{input rentalOffice}</div>
                                    </div>
                                </div>
                                <div class=" col-md-6">
                                    <div class="form-group">
                                        <div class="col-sm-12 text-right">{input reserve}</div>
                                    </div>
                                </div>
                            </div>
                        {/form}
                    {else}
                        <div class="alert alert-danger">Pokud si chcete rezervovat toto vozidlo, musíte se <a n:href="SignIn:" title="Přihlášení">přihlásit</a>.</div>
                    {/if}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading"><h3 class="panel-title">Seznam aktivní rezervací/výpujček</h3></div>

                {if count($vehicleReservations) > 0}
                <table class="table table-striped table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th class="col-md-2 text-center">Rezervováno</th>
                            <th class="col-md-2 text-center">Rezervace od</th>
                            <th class="col-md-2 text-center">Rezervace do</th>
                            <th class="col-md-2 text-center">Zapůjčeno</th>
                            <th class="col-md-2 text-center">Vráceno</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr n:foreach="$vehicleReservations as $rental" n:class="$rental->customerId == $user->id ? 'success'">
                            <td class="text-center">{$rental->reservedAt|date:'d.m.Y H:i'}</td>
                            <td class="text-center">{$rental->reservedFrom|date:'d.m.Y'}</td>
                            <td class="text-center">{$rental->reservedTo|date:'d.m.Y'}</td>
                            <td class="text-center">{ifset $rental->startAt}{$rental->startAt|date:'d.m.Y H:i'}{else}<em>Nevypůjčeno</em>{/ifset}</td>
                            <td class="text-center">{ifset $rental->endAt}{$rental->endAt|date:'d.m.Y H:i'}{else}<em>Nevráceno</em>{/ifset}</td>
                        </tr>
                    </tbody>
                </table>
                {else}
                <div class="panel-body">
                    <div class="alert alert-info">Pro dané vozidlo nejsou k dispozici žádné aktivní rezervace nebo výpůjčky.</div>
                </div>
                {/if}
            </div>
        </div>
    </div>
</div>
