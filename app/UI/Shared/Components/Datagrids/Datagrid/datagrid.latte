
<div class="row">
{control pagination}
</div>
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <div class="row">
                    <div class="col-md-6"><h3 class="panel-title">{$control->heading}</h3></div>
                    <div class="col-md-6">
                        {foreach $control->gridActions as $action}
                            <a class="btn btn-default btn-xs pull-right" href="{plink $action->target}" title="{$action->title}"><span class="{$action->icon}"></span> {$action->title}</a>
                        {/foreach}
                    </div>
                </div>
            </div>

            {include table.latte}
        </div>
    </div>
</div>
<div class="row">
{control pagination}
</div>
