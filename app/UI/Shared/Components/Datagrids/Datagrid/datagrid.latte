
<div class="row">
    <div class="col-md-12">
        {if $control->perPageOptions && $control->itemsPerPage !== null}
            {form perPageForm, class: 'form-inline pull-right datagrid-form'}
                <div class="col-md-12 form-group">
                    {label itemsPerPage/}
                    {input itemsPerPage, class: 'input-sm form-control'}
                    {input apply, class: 'btn btn-sm btn-default'}
                </div>
            {/form}
        {/if}
        {control pagination}
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <div class="row">
                    <div class="col-md-6">
                        <h3 class="panel-title">
                            {$control->heading}
                            <span class="badge badge-light">{$entityList->getMinIndex()} - {$entityList->getMaxIndex()} / {$entityList->getTotalCount()}</span>
                        </h3>
                    </div>
                    <div class="col-md-6">
                        {foreach $control->gridActions as $action}
                            <a class="btn btn-default btn-xs pull-right" href="{plink $action->target}" title="{$action->title}"><span class="{$action->icon}"></span> {$action->title}</a>
                        {/foreach}
                    </div>
                </div>
            </div>


            {if $control->bulkActions}
                {form bulkActionForm}
                <div n:foreach="$form->getErrors() as $error" class="alert alert-warning">{$error}</div>
                    {include table.latte}
                {/form}
            {else}
                {include table.latte}
            {/if}
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        {if $control->perPageOptions && $control->itemsPerPage !== null}
            {form perPageForm, class: 'form-inline pull-right datagrid-form'}
                <div class="col-md-12 form-group">
                    {label itemsPerPage/}
                    {input itemsPerPage, class: 'input-sm form-control'}
                    {input apply, class: 'btn btn-sm btn-default'}
                </div>
            {/form}
        {/if}
        {control pagination}
    </div>
</div>
