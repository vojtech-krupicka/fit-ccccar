{if count($entityList) > 0}
<table class="table table-bordered table-condensed">
    <thead>
        <tr>
            <th n:foreach="$control->columns as $column" n:class="$column->getCssClasses()">
                {$column->title ?? '&nbsp;'|noescape}
            </th>
        </tr>
    </thead>
    <tbody>
        <tr n:foreach="$entityList as $entity">
            <td n:foreach="$control->columns as $column" n:class="$column->getCssClasses()">
                {$column->getCellContent($entity) ?? $column->getEmptyValue()}
            </td>
        </tr>
    </tbody>
</table>
{else}
<div class="alert alert-danger">{$control->noDataMsg}</div>
{/if}
