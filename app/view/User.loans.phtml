?>


<?php if (count($CC_TEMPLATE->loans) > 0): ?>
    <?php $CC_TEMPLATE->paginator->render(); ?>

    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading"><h3 class="panel-title">Vaše výpůjčky</h3></div>
                <table class="table table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th class="text-center col-md-1">Číslo výpůjčky</th>
                            <th class="text-center col-md-3">Vozidlo<br />Km/Cena</th>
                            <th class="text-center col-md-4">Datum rezervace od/do<br />Datum zapůčení/vrácení</th>
                            <th class="text-center col-md-3">Zapůjčil<br />Přijal</th>
                            <th class="text-center col-md-1">&nbsp;</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($CC_TEMPLATE->loans as $loan): ?>
                        <?php
                            $trClass = '';
                            if ($loan->isDeleted()) {
                                $trClass = ' class="active"';
                            } else if (!$loan->getStartAt() && !$loan->getEndAt()) {
                                $trClass = ' class="danger"';
                            } else if ($loan->getStartAt() && !$loan->getEndAt()) {
                                $trClass = ' class="warning"';
                            }
                        ?>
                        <tr<?php echo $trClass; ?>>
                            <td class="text-center"><?php echo $loan->getId(); ?></td>
                            <td class="text-center">
                                <strong><?php echo $loan->getVehicle()->getFullName(); ?></strong><br />
                                <em><?php echo number_format($loan->getDistance(), 2); ?>km / <?php echo number_format($loan->getPrice(), 2); ?>Kč</em>
                            </td>
                            <td class="text-center">
                                <?php echo CC_Helper::printDate($loan->getReservedFrom(), 'd.m.Y'); ?> /
                                <?php echo CC_Helper::printDate($loan->getReservedTo(), 'd.m.Y'); ?><br />
                                <?php echo $loan->getStartAt() ? CC_Helper::printDate($loan->getStartAt(), 'd.m.Y h:s') : '<em>Nevypůjčeno</em>'; ?> / 
                                <?php echo $loan->getEndAt() ? CC_Helper::printDate($loan->getEndAt(), 'd.m.Y h:s') : '<em>Nevráceno</em>'; ?>
                            </td>
                            <td class="text-center">
                                <?php echo $loan->getBorrower() ? $loan->getBorrower()->getFullName() : '<em>Nevypůjčeno</em>'; ?><br />
                                <?php echo $loan->getRecipient() ? $loan->getRecipient()->getFullName() : '<em>Nevráceno</em>'; ?>
                            </td>
                            <td class="text-center">
                                <?php if (!$loan->getStartAt() && !$loan->getEndAt() && !$loan->isDeleted()): ?>
                                <a class="btn btn-danger btn-xs" href="<?php echo CC_Utils::link('storno!', array('id' => $loan->getId(), 'page' => $CC_TEMPLATE->paginator->getPage())); ?>" title="Zrušit výpujčku" onclick="if (!confirm('Opravdu chcete zrušit tuto výpůjčku?')) return false;"><span class="icon-remove"></span></a>
                                <?php else: ?>
                                <button class="btn btn-default btn-xs" disabled="disabled"><span class="icon-remove"></span></button>
                                <?php endif;?>
                            </td>
                        </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <?php $CC_TEMPLATE->paginator->render(); ?>
<?php else: ?>
    <div class="alert alert-danger">Nebyly nalezeny žádné výpůjčky!</div>
<?php endif; ?>

