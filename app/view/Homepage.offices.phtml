    <script src="http://api4.mapy.cz/loader.js"></script>   
    <script type="text/javascript">Loader.load();</script>
    <script>
        //<![CDATA[
        var map = new SMap(JAK.gel("map-container"));
        map.addControl(new SMap.Control.Sync());
        map.addDefaultLayer(SMap.DEF_SMART_BASE).enable();
        map.addDefaultControls();
        
        var cardLayer = new SMap.Layer.Marker();
        map.addLayer(cardLayer).enable();
        
        <?php foreach ($CC_TEMPLATE->rentalOfficeList as $office): ?>
            var card = new SMap.Card();
            card.setSize(224, 256);
            card.getHeader().innerHTML = '<h4><?php echo $office->getName(); ?></h4>';
            card.getBody().innerHTML = '<address>'
                + '<?php echo $office->getStreet(); ?><br />'
                + '<?php echo $office->getZip() . ' ' . $office->getCity(); ?><br />'
                + '<?php echo $office->getCountry(); ?><br />'
                + 'tel: <?php echo $office->getPhone(); ?><br />'
                + 'e-mail: <a href="mailto:<?php echo $office->getEmail(); ?>" title="<?php echo $office->getEmail(); ?>"><?php echo $office->getEmail(); ?></a>'
                + '</address>';
        
            var marker = new SMap.Marker(SMap.Coords.fromWGS84(<?php echo $office->getLon(); ?>, <?php echo $office->getLat(); ?>), 'office_<?php echo $office->getId(); ?>', {title: "<?php echo $office->getName(); ?>"});
            marker.decorate(SMap.Marker.Feature.Card, card);
            cardLayer.addMarker(marker); 
            
        <?php endforeach; ?>
        //]]>
    </script>
