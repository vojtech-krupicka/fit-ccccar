                                <?php echo $loan->getEndAt() ? '<abbr title="'.CC_Helper::printDate($loan->getStartAt(), 'd.m.Y h:i:s').'">' . CC_Helper::printDate($loan->getEndAt(), 'd.m.Y') . '</abbr>' : '<em>Nevráceno</em>'; ?>
